{
  "name": "joshua-nguyen-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-activity.mjs --fixtures && next dev",
    "build": "node scripts/fetch-cursor-usage.mjs && node scripts/prepare-activity.mjs && next build",
    "start": "next start",
    "activity:export": "node scripts/export-local-activity.mjs",
    "activity:prepare": "node scripts/prepare-activity.mjs",
    "activity:preflight": "node scripts/hook-installer.mjs preflight && node scripts/live-activity-collector.mjs --preflight",
    "activity:collect": "node scripts/live-activity-collector.mjs",
    "activity:backfill": "node scripts/live-activity-collector.mjs --full",
    "activity:backfill-history": "node scripts/backfill-history.mjs",
    "activity:import:cursor": "node scripts/import-cursor-usage.mjs",
    "activity:download:cursor": "node scripts/download-cursor-usage.mjs",
    "activity:refresh:cursor": "node scripts/download-cursor-usage.mjs && node scripts/prepare-activity.mjs",
    "activity:fetch:cursor": "node scripts/fetch-cursor-usage.mjs",
    "activity:audit": "node scripts/audit-activity.mjs",
    "activity:hooks:preflight": "node scripts/hook-installer.mjs preflight",
    "activity:hooks:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/manage-local-activity-hooks.ps1 -Action install",
    "activity:hooks:status": "node scripts/hook-installer.mjs status",
    "activity:hooks:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/manage-local-activity-hooks.ps1 -Action uninstall",
    "activity:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-live-activity-task.ps1",
    "public-safety:check": "node scripts/validate-public-repo.mjs",
    "privacy:check": "node scripts/validate-activity.mjs public/data/activity.json",
    "smoke": "node scripts/smoke-export.mjs && node scripts/smoke-http.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next",
    "verify": "npm run lint && npm run public-safety:check && npm test && npm run build && npm run activity:audit && npm run privacy:check && npm run smoke"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "marked": "18.0.9",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
