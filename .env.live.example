# Optional local overrides. No Cursor Team or Anthropic organization credential is required.
# The collector uses the existing `gh auth` login when GITHUB_PUBLISH_TOKEN is empty.
GITHUB_REPOSITORY=JoshuaNguyen123/JoshuaNguyen123.github.io
GITHUB_USERNAME=JoshuaNguyen123
GITHUB_PUBLISH_TOKEN=

ACTIVITY_DATA_BRANCH=activity-data
ACTIVITY_DATA_PATH=activity.json

# Optional. Defaults to %LOCALAPPDATA%\EngineeringActivity.
ENGINEERING_ACTIVITY_HOME=

# Optional. Override Cursor's state.vscdb path (WSL / nonstandard installs).
# Default on Windows: %APPDATA%\Cursor\User\globalStorage\state.vscdb
CURSOR_STATE_DB_PATH=

# Optional: Cursor Admin API key (Teams/Enterprise). Used only if the local
# state.vscdb → dashboard CSV download fails. Presence days only are stored.
CURSOR_ADMIN_API_KEY=
