# Optional locally. GitHub Actions supplies its repository-scoped token.
GITHUB_TOKEN=
GITHUB_USERNAME=JoshuaNguyen123

# Forward-only stamp zone for *new* activity days. Home is America/Denver.
# Leave this unset while travelling so new events follow the machine clock.
# Never re-export to rewrite history after changing it — completed days stay
# where they were stamped.
#   ACTIVITY_TIME_ZONE=America/Denver
ACTIVITY_TIME_ZONE=

# Optional test/source overrides for the privacy-safe local exporter.
CODEX_ACTIVITY_ROOT=
CLAUDE_ACTIVITY_ROOT=
ACTIVITY_OUTPUT=
CURSOR_STATE_DB_PATH=
CURSOR_ACTIVITY_DB=
CURSOR_EXPORT_DIR=

# Optional live-feed overrides belong in the ignored .env.live file. The no-cost
# local mode uses the existing GitHub CLI login and needs no vendor API key.
# Cursor usage presence is refreshed automatically from the local Cursor login
# (state.vscdb → dashboard CSV). Re-run `npm run activity:schedule` to install
# the hourly collector task.

# Public contact configuration. The browser sends the hCaptcha token to the
# Cloudflare Worker; the worker verifies it before relaying to Web3Forms.
NEXT_PUBLIC_CONTACT_API_URL=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Two more public overrides exist. They are deliberately left commented out
# rather than assigned empty: both are read with `??`, which only falls back on
# undefined, so a bare `NAME=` line would inline an empty string and break the
# feed and the editor outright. Uncomment only to point the build elsewhere.
#
#   NEXT_PUBLIC_ACTIVITY_FEED_URL   where the dashboard polls the activity
#                                   snapshot. Defaults to the raw.githubusercontent
#                                   copy of public/data/activity.json on main.
#   NEXT_PUBLIC_BLOG_ADMIN_API_URL  base URL for the /admin editor's worker.
#                                   Defaults to the deployed workers.dev origin.
#
# Every NEXT_PUBLIC_* value is inlined into the static export at build time, so
# whatever is set here ships to every visitor: a localhost URL left in either one
# publishes an app that talks to a host nobody else can reach. Both origins are
# also pinned in the Content-Security-Policy connect-src in app/layout.tsx, so
# changing one without updating that policy blocks the request in the browser.
#
# NEXT_PUBLIC_ACTIVITY_FEED_URL=
# NEXT_PUBLIC_BLOG_ADMIN_API_URL=

# Worker secrets are never NEXT_PUBLIC values. Configure them with:
#   wrangler secret put HCAPTCHA_SECRET --config admin-worker/wrangler.jsonc
#   wrangler secret put WEB3FORMS_ACCESS_KEY --config admin-worker/wrangler.jsonc
#
# Two optional worker vars, set in admin-worker/wrangler.jsonc under "vars":
#   HCAPTCHA_SITE_KEY   the public site key, sent to hCaptcha's siteverify so a
#                       token minted against another site key on the same
#                       account cannot be redeemed here.
#   ALLOW_LOCAL_ORIGINS set to "1" only in a development deployment. It admits
#                       http://localhost:3000 and http://127.0.0.1:3000, which
#                       production must never accept: hCaptcha site keys
#                       normally allow localhost, so a page served from any
#                       machine could otherwise mint a token this worker takes.
