{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "joshua-portfolio-blog-admin",
	"main": "src/index.mjs",
	"compatibility_date": "2026-08-24",
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
    "OAUTH_CALLBACK_URL": "https://joshua-portfolio-blog-admin.personal-ai-digest.workers.dev/auth/callback"
	},
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "95889be6a4754bd7b6e81770de366f4d"
		}
	],
	"ratelimits": [
		{
			"name": "AUTH_START_RATE_LIMITER",
			"namespace_id": "4720250826",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "AUTH_CALLBACK_RATE_LIMITER",
			"namespace_id": "4720250827",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			// The contact relay is the only unauthenticated write path, and each
			// accepted submission spends part of the Web3Forms monthly quota.
			"name": "CONTACT_RATE_LIMITER",
			"namespace_id": "4720250828",
			"simple": { "limit": 3, "period": 60 }
		}
	]
}
