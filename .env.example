# Optional locally. GitHub Actions supplies its repository-scoped token.
GITHUB_TOKEN=
GITHUB_USERNAME=JoshuaNguyen123

# Optional test/source overrides for the privacy-safe local exporter.
CODEX_ACTIVITY_ROOT=
CLAUDE_ACTIVITY_ROOT=
ACTIVITY_OUTPUT=
CURSOR_STATE_DB_PATH=
CURSOR_ACTIVITY_DB=
CURSOR_EXPORT_DIR=

# Optional live-feed overrides belong in the ignored .env.live file. The no-cost
# local mode uses the existing GitHub CLI login and needs no vendor API key.
# Cursor usage presence is refreshed automatically from the local Cursor login
# (state.vscdb → dashboard CSV). Re-run `npm run activity:schedule` to install
# the hourly collector task.

# Contact form (Web3Forms). Get a key at https://web3forms.com by entering the inbox address.
# The key is public-safe; it only identifies which inbox receives submissions.
NEXT_PUBLIC_WEB3FORMS_KEY=
