{
  "name": "joshua-nguyen-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-activity.mjs --fixtures && next dev",
    "build": "node scripts/prepare-activity.mjs && next build",
    "start": "next start",
    "activity:export": "node scripts/export-local-activity.mjs",
    "activity:prepare": "node scripts/prepare-activity.mjs",
    "privacy:check": "node scripts/validate-activity.mjs public/data/activity.json",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "marked": "18.0.9",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
